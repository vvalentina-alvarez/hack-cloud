mxCell id="v138" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#B0084D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="20" y="1095" width="44" height="44" as="geometry"/></mxCell><mxCell id="v139" value="&lt;b&gt;CloudWatch&lt;/b&gt; · logs de cada Lambda&lt;br&gt;(sam logs -n &amp;lt;función&amp;gt; --tail)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;" vertex="1" parent="1"><mxGeometry x="70" y="1092" width="200" height="50" as="geometry"/></mxCell><mxCell id="v140" value="&lt;b&gt;IAM:&lt;/b&gt; todas las Lambdas, la Step Function y la regla de EventBridge usan el rol &lt;b&gt;LabRole&lt;/b&gt; de AWS Academy (Learner Lab no permite crear roles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="1090" width="330" height="55" as="geometry"/></mxCell><mxCell id="v141" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FF8000&quot;&gt;■&lt;/font&gt; Lambda expuesta por API Gateway · &lt;font color=&quot;#E7157B&quot;&gt;■&lt;/font&gt; Lambda disparada por SQS, S3, EventBridge o Streams · &lt;font color=&quot;#3D7EDB&quot;&gt;■&lt;/font&gt; Lambda interna (sin ruta) · &lt;font color=&quot;#9C27B0&quot;&gt;■&lt;/font&gt; estado de Step Functions&lt;br&gt;── negro: HTTPS del navegador · ── azul: lectura/escritura DynamoDB · ┄ azul: invocación directa (Lambda o modelo de IA) · ── rosado: mensaje o evento (SQS, EventBridge, SNS, Streams)&lt;br&gt;── verde: subida directa a S3 · ── azul claro: exportación a GCP / Azure&lt;br&gt;&lt;b&gt;Estado real:&lt;/b&gt; AWS operativo · GCP y Azure preparados pero no desplegados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=9;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="650" y="1080" width="800" height="80" as="geometry"/></mxCell><mxCell id="v142" value="&lt;b&gt;100% serverless · pago por uso&lt;/b&gt;&lt;br&gt;Lambda · DynamoDB on-demand · SQS · Step Functions · S3 · BigQuery · Blob&lt;br&gt;sin servidores encendidos (no EC2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2D7600;fontSize=9;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1470" y="1080" width="340" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>