e por zona) → evento &lt;b&gt;ZoneThresholdReached&lt;/b&gt;&lt;br&gt;umbral y ventana leídos de Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=9;arcSize=6;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="270" y="397" width="220" height="72" as="geometry"/></mxCell><mxCell id="v30" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#527FFF;gradientDirection=north;fillColor=#2E27AD;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="356" y="690" width="48" height="48" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;t_zonas&lt;/b&gt;&lt;br&gt;PK=ZONE#geohash&lt;br&gt;SK=USER#id | ACTIVE_INCIDENT&lt;br&gt;TTL 24 h (expiresAt)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#3333CC;" vertex="1" parent="1"><mxGeometry x="270" y="742" width="220" height="62" as="geometry"/></mxCell><mxCell id="e32" value="R/W" style="html=1;fontSize=9;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;labelBackgroundColor=#FFFFFF;startArrow=classic;strokeColor=#3333CC;strokeWidth=2;fontColor=#3333CC;" edge="1" parent="1" target="v30"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="482" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="e33" value="escribe META + EVENT" style="html=1;fontSize=9;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;labelBackgroundColor=#FFFFFF;strokeColor=#3333CC;strokeWidth=2;fontColor=#3333CC;" edge="1" parent="1" target="v21"><mxGeometry relative="1" as="geometry"><mxPoint x="268" y="714" as="sourcePoint"/><Array as="points"><mxPoint x="200" y="714"/></Array></mxGeometry></mxCell><mxCell id="v34" value="M3 · Antenas (monitoreo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF5;strokeColor=#FF8000;